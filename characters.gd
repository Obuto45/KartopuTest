static func get_char(i: int) -> Dictionary:
	return LIST[clampi(i, 0, LIST.size() - 1)]


## Karakterin pasif özelliklerini sayılarından üretir (yazı ile kod hiç ayrışmaz).
static func passive_text(c: Dictionary) -> String:
	var p := PackedStringArray()
	if c.has("hp"): p.append("%d can" % c.hp)
	if c.has("speed"): p.append("%+d%% hız" % roundi((c.speed - 1.0) * 100.0))
	if c.has("shield_cd"): p.append("kalkan %d sn'de dolar" % c.shield_cd)
	if c.has("dodge"): p.append("%%%d şansla hasardan sıyrılır" % roundi(c.dodge * 100.0))
	if c.has("throw_mult"): p.append("roketleri %%%d hızlı" % roundi((c.throw_mult - 1.0) * 100.0))
	if c.has("fire_cd"): p.append("%%%d seri ateş" % roundi((1.0 / c.fire_cd - 1.0) * 100.0))
	if c.has("rocket_dmg"): p.append("roket hasarı %d" % c.rocket_dmg)
	if c.has("sword_dmg"): p.append("kılıç hasarı %d" % c.sword_dmg)
	if c.has("regen"): p.append("saniyede %s can yeniler" % str(c.regen))
	if c.has("jump"): p.append("%%%d yüksek zıplar" % roundi((c.jump - 1.0) * 100.0))
	if c.has("air_jumps"): p.append("havada %d kez zıplar" % c.air_jumps)
	if c.has("wall_cd"): p.append("duvar %d sn'de dolar" % c.wall_cd)
	if c.get("sit_shield", false): p.append("2 sn durunca kendiliğinden kalkan alır")
	return " • ".join(p) if not p.is_empty() else "Dengeli: zaafı da yok, üstünlüğü de."
